{
  "builds": [
    {
      "src": "bookmyseat/wsgi.py",
      "use": "@vercel/python",
      "config": {
        "includeFiles": [
          "db.sqlite3",
          "templates/**",
          "media/**"
        ]
      }
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "bookmyseat/wsgi.py"
    }
  ]
}